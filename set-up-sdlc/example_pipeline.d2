# The route a change takes, for AGENTS-example.md.
# Render to example_pipeline.png (layout elk, pad 40) whenever this changes.
direction: down

classes: {
  station: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 8
      font-size: 20
    }
  }
  finish: {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      border-radius: 8
      font-size: 20
    }
  }
  gate: {
    style: {
      font-size: 18
      font-color: "#1f2937"
      italic: false
    }
  }
}

local: On your machine {
  grid-rows: 1
  horizontal-gap: 260
  style.font-size: 24
  change: Change made {class: station}
  commit: Committed {class: station}
  change -> commit: 1 Commit hook {class: gate}
}

github: On GitHub {
  grid-rows: 1
  horizontal-gap: 260
  style.font-size: 24
  pr: Pull request open {class: station}
  reviewed: Reviewed {class: station}
  merged: Merged to main {class: station}
  pr -> reviewed: 2 CI\n3 Review {class: gate}
  reviewed -> merged: 4 Up to date\n5 The human merges {class: gate}
}

deployed: Deployed {
  grid-rows: 1
  horizontal-gap: 260
  style.font-size: 24
  uat: On UAT {class: station}
  proved: Proved on UAT {class: station}
  prod: In production {class: finish}
  uat -> proved: 7 Deploy check\nand UAT journey {class: gate}
  proved -> prod: 8 The human deploys {class: gate}
}

local -> github: Pushed when the human asks {class: gate}
github -> deployed: 6 Deploy {class: gate}
