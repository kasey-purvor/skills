# The route a change takes and its six gates, for AGENTS-example.md.
# Render to example_pipeline.png (layout elk, pad 40) whenever this changes.
direction: down

classes: {
  station: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 8
      font-size: 20
    }
  }
  finish: {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      border-radius: 8
      font-size: 20
    }
  }
  gate: {
    style: {
      font-size: 20
      font-color: "#b45309"
      bold: true
      italic: false
    }
  }
}

local: On your machine {
  grid-rows: 1
  horizontal-gap: 260
  style.font-size: 24
  change: Change made {class: station}
  commit: Committed {class: station}
  change -> commit: G1 Commit {class: gate}
}

github: On GitHub {
  grid-rows: 1
  horizontal-gap: 260
  style.font-size: 24
  pr: Pull request green {class: station}
  merged: Merged to main {class: station}
  pr -> merged: G3 Merge {class: gate}
}

deployed: Deployed {
  grid-rows: 1
  horizontal-gap: 260
  style.font-size: 24
  integ: On integration {class: station}
  uat: On UAT {class: station}
  prod: In production {class: finish}
  integ -> uat: G5 Promote {class: gate}
  uat -> prod: G6 Deploy {class: gate}
}

local -> github: G2 Pull request {class: gate}
github -> deployed: G4 Automatic {class: gate}
