# The route a change takes, for AGENTS-example.md.
# Render to example_pipeline.png (layout elk, pad 40) whenever this changes.
direction: down

classes: {
  station: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 8
      font-size: 20
    }
  }
  finish: {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      border-radius: 8
      font-size: 20
    }
  }
  gate: {
    style: {
      font-size: 18
      font-color: "#1f2937"
      italic: false
    }
  }
}

local: On your machine {
  grid-rows: 1
  horizontal-gap: 280
  style.font-size: 24
  change: Change made {class: station}
  commit: Committed {class: station}
  change -> commit: Commit hook\n(T1, T2) {class: gate}
}

github: On GitHub {
  grid-rows: 1
  horizontal-gap: 280
  style.font-size: 24
  pr: Pull request open {class: station}
  reviewed: Reviewed {class: station}
  merged: Merged to main {class: station}
  pr -> reviewed: CI (T1 to T7)\nReview {class: gate}
  reviewed -> merged: Up to date\nThe human merges {class: gate}
}

deployed: Deployed {
  grid-rows: 1
  horizontal-gap: 280
  style.font-size: 24
  uat: On UAT {class: station}
  proved: Proved on UAT {class: station}
  prod: In production {class: finish}
  uat -> proved: Deploy check (T8)\nUAT journey (T9) {class: gate}
  proved -> prod: The human deploys {class: gate}
}

local -> github: Pushed when the human asks {class: gate}
github -> deployed: Deploy, if CI proved this code {class: gate}
