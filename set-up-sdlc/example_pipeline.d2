# The route a change takes, for AGENTS-example.md.
# Render to example_pipeline.png (layout elk, pad 40) whenever this changes.
direction: down

classes: {
  station: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 8
      font-size: 20
    }
  }
  finish: {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      border-radius: 8
      font-size: 20
    }
  }
  gate: {
    style: {
      font-size: 18
      font-color: "#1f2937"
      italic: false
    }
  }
}

local: On your machine {
  grid-rows: 1
  horizontal-gap: 300
  style.font-size: 24
  change: Change made {class: station}
  commit: Committed {class: station}
  change -> commit: C1 Commit hook\n(T1, T2) {class: gate}
}

github: On GitHub {
  grid-rows: 1
  horizontal-gap: 300
  style.font-size: 24
  pr: Pull request open {class: station}
  reviewed: Reviewed {class: station}
  merged: Merged to main {class: station}
  pr -> reviewed: C4 CI (T1 to T7)\nC5 Review {class: gate}
  reviewed -> merged: C6 Up to date\nC7 The human merges {class: gate}
}

deployed: Deployed {
  grid-rows: 1
  horizontal-gap: 300
  style.font-size: 24
  uat: On UAT {class: station}
  proved: Proved on UAT {class: station}
  prod: In production {class: finish}
  uat -> proved: UAT journey (T9) {class: gate}
  proved -> prod: C8 Passed CI\nC9 The human deploys {class: gate}
}

local -> github: C2 Pushed when the human asks\nC3 Through a pull request {class: gate}
github -> deployed: C8 Passed CI\nDeploy check (T8) {class: gate}
